# Copy this file to ".env" and fill in values. NEVER commit the real .env file.

# --- Database ---
# Leave empty to use local SQLite (scamshield.db).
# For the live site use Supabase: Project Settings -> Database -> Connection string (URI, "Session pooler")
# DATABASE_URL=postgresql://postgres.xxxx:YOUR_PASSWORD@aws-0-ap-south-1.pooler.supabase.com:5432/postgres

# --- Optional: free LLM for friendly explanations (app works without it) ---
# Groq free tier: https://console.groq.com/keys
# LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
# Google Gemini (OpenAI-compatible endpoint) also works:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# LLM_MODEL=gemini-2.0-flash

# --- Telegram bot ---
# TELEGRAM_BOT_TOKEN=
# SCAMSHIELD_API_URL=http://127.0.0.1:8000

# --- Optional ---
# USE_TRANSFORMER=false
# RATE_LIMIT_PER_MINUTE=30
