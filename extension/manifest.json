{
  "manifest_version": 3,
  "name": "ScamShield – Link Checker",
  "version": "1.0.0",
  "description": "Checks if the current page or any link is a phishing/scam site using the ScamShield AI.",
  "permissions": ["activeTab", "contextMenus", "storage"],
  "host_permissions": ["http://127.0.0.1:8000/*", "https://*.hf.space/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_popup": "popup.html", "default_title": "ScamShield" },
  "options_page": "options.html"
}
